<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.courseselectionsystem.mapper.ChatMessageMapper">

    <resultMap id="ChatMessageResultMap" type="org.example.courseselectionsystem.entity.ChatMessage">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectBySessionId" resultMap="ChatMessageResultMap">
        SELECT * FROM chat_message 
        WHERE session_id = #{sessionId}
        ORDER BY id ASC
    </select>

    <delete id="deleteBySessionId">
        DELETE FROM chat_message WHERE session_id = #{sessionId}
    </delete>

    <select id="countBySessionId" resultType="int">
        SELECT COUNT(*) FROM chat_message WHERE session_id = #{sessionId}
    </select>

</mapper>
